
    public static void main(String[] args) {

        Scannerimport java.util.Scanner;

public class SkillGapAnalyzer {
 sc = new Scanner(System.in);

        System.out.println("=================================");
        System.out.println("       SKILL GAP ANALYZER");
        System.out.println("=================================");

        System.out.print("Enter your name: ");
        String name = sc.nextLine();

        System.out.println("\nSelect your career:");
        System.out.println("1. Data Analyst");
        System.out.println("2. Software Developer");
        System.out.println("3. AI/ML Engineer");

        System.out.print("Enter choice: ");
        int choice = sc.nextInt();
        sc.nextLine();

        String career = "";
        String[] requiredSkills;

        // Select required skills according to career
        if (choice == 1) {

            career = "Data Analyst";

            requiredSkills = new String[]{
                "Python",
                "SQL",
                "Excel",
                "Statistics",
                "Power BI",
                "Data Visualization"
            };

        } else if (choice == 2) {

            career = "Software Developer";

            requiredSkills = new String[]{
                "Java",
                "Python",
                "DSA",
                "SQL",
                "Git",
                "OOP"
            };

        } else if (choice == 3) {

            career = "AI/ML Engineer";

            requiredSkills = new String[]{
                "Python",
                "Machine Learning",
                "Statistics",
                "NumPy",
                "Pandas",
                "Linear Algebra"
            };

        } else {

            System.out.println("Invalid choice!");
            sc.close();
            return;
        }

        System.out.print("\nHow many skills do you have? ");
        int n = sc.nextInt();
        sc.nextLine();

        String[] studentSkills = new String[n];

        for (int i = 0; i < n; i++) {

            System.out.print("Enter skill " + (i + 1) + ": ");
            studentSkills[i] = sc.nextLine();
        }

        int matched = 0;

        System.out.println("\n=================================");
        System.out.println("          ANALYSIS RESULT");
        System.out.println("=================================");

        System.out.println("Student : " + name);
        System.out.println("Career  : " + career);

        System.out.println("\nSkill Analysis:");

        for (int i = 0; i < requiredSkills.length; i++) {

            boolean found = false;

            for (int j = 0; j < studentSkills.length; j++) {

                if (requiredSkills[i].equalsIgnoreCase(studentSkills[j])) {
                    found = true;
                    break;
                }
            }

            if (found) {
                System.out.println("✓ " + requiredSkills[i] + " - Available");
                matched++;
            } else {
                System.out.println("✗ " + requiredSkills[i] + " - Missing");
            }
        }

        double percentage =
                (matched * 100.0) / requiredSkills.length;

        System.out.println("\nSkill Match: " + percentage + "%");

        System.out.println("\nSkills You Should Learn:");

        for (int i = 0; i < requiredSkills.length; i++) {

            boolean found = false;

            for (int j = 0; j < studentSkills.length; j++) {

                if (requiredSkills[i].equalsIgnoreCase(studentSkills[j])) {
                    found = true;
                    break;
                }
            }

            if (!found) {
                System.out.println("- " + requiredSkills[i]);
            }
        }

        System.out.println("\n=================================");
        System.out.println("       ANALYSIS COMPLETED");
        System.out.println("=================================");

        sc.close();
    }
}